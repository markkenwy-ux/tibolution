{
  "name": "tibolution",
  "version": "2.2.0-cdp.2",
  "description": "Model-agnostic reasoning-effort backgrounds for Codex Desktop with guarded ASAR patching.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "codex-desktop",
    "electron",
    "asar",
    "reasoning-effort"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cdp:apply": "node scripts/cdp/runner.mjs apply",
    "cdp:watch": "node scripts/cdp/runner.mjs watch",
    "cdp:status": "node scripts/cdp/runner.mjs status",
    "cdp:remove": "node scripts/cdp/runner.mjs remove",
    "test": "node --test tests/*.test.mjs",
    "inspect": "node scripts/inspect-asar.mjs",
    "build": "node scripts/build-patched-asar.mjs",
    "release:check": "npm test && npm pack --dry-run --json"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "jsdom": "^26.1.0"
  }
}
